{
  "manifest_version": 3,
  "name": "GPT Lens for ChatGPT",
  "short_name": "GPT Lens",
  "version": "0.1.1",
  "description": "Observe ChatGPT request models, compare them with server-exposed model metadata, track local usage, sync with Google Drive, and export selected turns to Markdown.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "000000000000-gpt-lens-placeholder.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/route-parser.js",
        "src/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/model-utils.js",
        "src/content.js"
      ],
      "css": [
        "src/ui.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GPT Lens",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
